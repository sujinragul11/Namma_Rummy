[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/profile.gd" id="1_profile"]

[node name="ProfilePanel" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_profile")

[node name="Shade" type="ColorRect" parent="."]
unique_name_in_owner = true
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.72)

[node name="Margin" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 150
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 150
theme_override_constants/margin_bottom = 16

[node name="Panel" type="PanelContainer" parent="Margin"]
unique_name_in_owner = true
size_flags_vertical = 0

[node name="Box" type="VBoxContainer" parent="Margin/Panel"]
theme_override_constants/separation = 14

[node name="Header" type="HBoxContainer" parent="Margin/Panel/Box"]
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Panel/Box/Header"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 32
text = "Profile"

[node name="CloseButton" type="Button" parent="Margin/Panel/Box/Header"]
unique_name_in_owner = true
text = "Close"

[node name="EditRow" type="HBoxContainer" parent="Margin/Panel/Box"]
theme_override_constants/separation = 12

[node name="ProfileNameEdit" type="LineEdit" parent="Margin/Panel/Box/EditRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.8
placeholder_text = "Username"
max_length = 20

[node name="ProfileEmailEdit" type="LineEdit" parent="Margin/Panel/Box/EditRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
placeholder_text = "Email"
max_length = 100
virtual_keyboard_type = 5

[node name="SaveProfileButton" type="Button" parent="Margin/Panel/Box/EditRow"]
unique_name_in_owner = true
disabled = true
text = "Save"

[node name="BadgeHolder" type="HBoxContainer" parent="Margin/Panel/Box"]
unique_name_in_owner = true

[node name="StatsRow" type="HBoxContainer" parent="Margin/Panel/Box"]

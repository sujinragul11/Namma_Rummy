# Copy to .env and fill in. With NODE_ENV=production the server refuses to start until
# JWT_SECRET, LEGAL_OWNER and SUPPORT_EMAIL are set.

NODE_ENV=production
PORT=3001

# Signs every login. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later logs every player out.
JWT_SECRET=

# Shown on the privacy policy, the terms and the account deletion page
APP_NAME=Namma Rummy
LEGAL_OWNER=
SUPPORT_EMAIL=

# Database: either one URL (what most hosting platforms give you) ...
DATABASE_URL=
# ... or the separate values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=My_Rummy
DB_USER=postgres
# With docker-compose.yml this becomes the database password; use letters and digits only
DB_PASSWORD=

# Optional: keeps running games across a server restart
REDIS_URL=

# Number of proxies in front of the server (nginx or a hosting platform's router is 1)
TRUST_PROXY=1

# Sign-up and password reset send a 6-digit code by SMS to prove the mobile number is the
# player's own. Make a free Twilio account (twilio.com), then under Verify > Services create
# a service and copy its SID. Without these three, numbers are NOT verified: accounts are
# made without a code and a forgotten password cannot be reset by SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Seconds a number waits before another code can be sent (default 30)
SMS_RESEND_SECONDS=30
